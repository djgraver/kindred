rules_version = '2';
// Kindred has no passwords, so anyone with the link can read and sign in.
// These rules keep the data tidy and enforce one check-in per 4 hours.
service cloud.firestore {
  match /databases/{db}/documents {
    match /people/{id} {
      function levels(e) {
        return e.keys().hasOnly(['at','sickness','sleep','stress','affection'])
          && e.sickness is int && e.sickness >= 0 && e.sickness <= 100
          && e.sleep is int && e.sleep >= 0 && e.sleep <= 100
          && e.stress is int && e.stress >= 0 && e.stress <= 100
          && e.affection is int && e.affection >= 0 && e.affection <= 100;
      }
      function nameOk(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 30 && d.name.lower() == id; }
      function partnerOk(d) { return d.partner == null || (d.partner is string && d.partner.size() <= 30); }

      allow read: if true;
      allow create: if nameOk(request.resource.data) && request.resource.data.partner == null
        && request.resource.data.entries.size() == 0 && request.resource.data.lastAt == null
        && request.resource.data.keys().hasOnly(['name','partner','entries','lastAt']);
      allow update: if request.resource.data.keys().hasOnly(['name','partner','entries','lastAt'])
        && request.resource.data.name == resource.data.name
        && partnerOk(request.resource.data)
        && (
          // changing partner only
          (request.resource.data.entries == resource.data.entries && request.resource.data.lastAt == resource.data.lastAt)
          ||
          // adding a check-in: at most once every 4 hours
          (request.resource.data.lastAt == request.time
            && (resource.data.lastAt == null || request.time > resource.data.lastAt + duration.value(4, 'h'))
            && request.resource.data.entries.size() >= 1 && request.resource.data.entries.size() <= 12
            && levels(request.resource.data.entries[request.resource.data.entries.size() - 1]))
        );
      allow delete: if false;
    }
  }
}
